POSTGRES_DB=casa_db
POSTGRES_USER=casa
POSTGRES_PASSWORD=replace_with_a_strong_unique_password

# production is fail-closed: HTTPS origin and a valid Fernet key are mandatory.
CASA_ENV=production
PUBLIC_APP_URL=https://t2phealth.com.br
CASA_DOMAIN=t2phealth.com.br
# Generate locally: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
AUTH_ENCRYPTION_KEY=
# Use Caddyfile.http-ingestion ONLY during the transition of existing HTTP stations.
CADDY_CONFIG_PATH=./infra/Caddyfile

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=contato@t2phealth.com.br
